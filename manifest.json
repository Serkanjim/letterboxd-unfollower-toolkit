{
  "manifest_version": 3,
  "name": "Letterboxd Unfollower Toolkit",
  "version": "1.0",
  "description": "Find out who is not following you back on Letterboxd.",
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://letterboxd.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}