{
  "manifest_version": 3,
  "name": "Letterboxd Unfollower Toolkit",
  "version": "2.0",
  "description": "The ultimate unfollower tracker for Letterboxd. Find who isn't following back and open profiles directly to manage connections.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://letterboxd.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
